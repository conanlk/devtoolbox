<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="using:DevToolBox.App.Shared"
             x:Class="DevToolBox.App.App"
             Name="DevToolBox"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://DevToolBox/Themes/Colors.axaml" />
        <ResourceInclude Source="avares://DevToolBox/Themes/Icons.axaml" />
        <ResourceInclude Source="avares://DevToolBox/Themes/Flags.axaml" />
        <ResourceInclude Source="avares://DevToolBox/Themes/Controls.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <!-- ComboBox options and other labeled items: bound, so a language switch relabels them in place. -->
  <Application.DataTemplates>
    <DataTemplate DataType="shared:ILabeled" x:DataType="shared:ILabeled">
      <TextBlock Text="{Binding Label}" />
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#F2B544" RegionColor="#0E1014" />
        <ColorPaletteResources x:Key="Light" Accent="#F2B544" RegionColor="#F6F7F9" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <StyleInclude Source="avares://DevToolBox/Themes/Styles.axaml" />
  </Application.Styles>
</Application>
