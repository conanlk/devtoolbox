<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:DevToolBox.App.Localization"
             xmlns:vm="using:DevToolBox.App.Tools.Hash"
             xmlns:controls="using:DevToolBox.App.Shared.Controls"
             xmlns:behaviors="using:DevToolBox.App.Shared.Behaviors"
             xmlns:conv="using:DevToolBox.App.Shared.Converters"
             x:Class="DevToolBox.App.Tools.Hash.HashView"
             x:DataType="vm:HashViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="status-bar">
      <WrapPanel ItemSpacing="16">
        <TextBlock Name="StatusBarText" Text="{Binding StatusText}" />
        <TextBlock Text="{Binding UnsupportedNote}" IsVisible="{Binding UnsupportedNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </WrapPanel>
    </Border>

    <ScrollViewer>
      <StackPanel Margin="32,8,32,24" Spacing="16">
        <Border Classes="toolbar">
          <WrapPanel ItemSpacing="14" LineSpacing="8">
            <Border Classes="segmented">
              <StackPanel Orientation="Horizontal">
                <RadioButton Theme="{StaticResource SegmentButton}" GroupName="source" Content="{l:Tr Hash_SourceText}" Name="TextSource"
                             IsChecked="{Binding Source, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter=Text}" />
                <RadioButton Theme="{StaticResource SegmentButton}" GroupName="source" Content="{l:Tr Hash_SourceFile}" Name="FileSource"
                             IsChecked="{Binding Source, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter=File}" />
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="field-label" Text="{l:Tr Common_Output}" />
              <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" AutomationProperties.Name="{l:Tr Hash_OutputFormat}" />
            </StackPanel>
            <CheckBox Name="HmacBox" Content="HMAC" IsChecked="{Binding UseHmac}" VerticalAlignment="Center" />
            <TextBox Name="HmacKeyBox" Classes="mono" Text="{Binding HmacKey}" PlaceholderText="{l:Tr Hash_HmacKey}" Width="220"
                     IsVisible="{Binding UseHmac}" AutomationProperties.Name="{l:Tr Hash_HmacKey}" />
          </WrapPanel>
        </Border>

        <controls:ToolPanel Header="{l:Tr Hash_TextHeader}" Padding="0"
                            IsVisible="{Binding Source, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter=Text}">
          <controls:ToolPanel.Actions>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <controls:PasteButton Classes="quiet" Text="{Binding TextInput}" />
              <controls:ClearButton Classes="quiet" Text="{Binding TextInput}" />
            </StackPanel>
          </controls:ToolPanel.Actions>
          <TextBox Name="TextInputBox" Classes="mono bare" Text="{Binding TextInput}" AcceptsReturn="True" TextWrapping="Wrap"
                   Height="130" PlaceholderText="{l:Tr Hash_TextPlaceholder}" AutomationProperties.Name="{l:Tr Hash_TextToHash}" />
        </controls:ToolPanel>

        <Border Classes="drop-zone" Name="DropZone" behaviors:FileDrop.Command="{Binding HashFileCommand}"
                IsVisible="{Binding Source, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter=File}">
          <StackPanel Spacing="10" HorizontalAlignment="Center">
            <controls:LucideIcon Kind="Upload" Width="28" Height="28" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" />
            <TextBlock Text="{l:Tr Common_DropFileOr}" HorizontalAlignment="Center" />
            <Button Name="ChooseFileButton" Classes="primary tool" Command="{Binding OpenFileCommand}" HorizontalAlignment="Center" Height="36"
                    Padding="16,0" AutomationProperties.Name="{l:Tr Common_ChooseFileName}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <controls:LucideIcon Kind="FolderOpen" Width="14" Height="14" />
                <TextBlock Text="{l:Tr Common_ChooseFile}" />
              </StackPanel>
            </Button>
            <TextBlock Classes="mono" Name="FileNameText" Text="{Binding FileName}" HorizontalAlignment="Center"
                       IsVisible="{Binding FileName, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Classes="hint" Text="{Binding FileDetails}" HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsHashing}" HorizontalAlignment="Center">
              <ProgressBar Name="HashProgress" Value="{Binding Progress}" Width="260" />
              <controls:CommandButton Icon="X" Label="{l:Tr Common_Cancel}" Command="{Binding CancelHashingCommand}" />
            </StackPanel>
            <TextBlock Classes="hint" Text="{l:Tr Hash_StreamNote}" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>

        <TextBlock Classes="error" Name="ErrorText" Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <controls:ToolPanel Header="{l:Tr Hash_Hashes}">
          <ItemsControl Name="HashList" ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HashRowViewModel">
                <Border BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,0,0,1" Padding="0,6">
                  <Grid ColumnDefinitions="96,*,Auto,Auto" ColumnSpacing="12">
                    <Border Classes="chip" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding Name}" />
                    </Border>
                    <SelectableTextBlock Grid.Column="1" Classes="mono" Text="{Binding Value}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Classes="success" Text="{l:Tr Hash_MatchBadge}" FontSize="12" FontWeight="SemiBold" IsVisible="{Binding IsMatch}"
                               VerticalAlignment="Center" />
                    <controls:CopyButton Grid.Column="3" Classes="quiet" Text="{Binding Value}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </controls:ToolPanel>

        <controls:ToolPanel Header="{l:Tr Hash_CompareHeader}">
          <StackPanel Spacing="8">
            <TextBox Name="ExpectedBox" Classes="mono" Text="{Binding ExpectedHash}" PlaceholderText="{l:Tr Hash_ExpectedPlaceholder}"
                     AutomationProperties.Name="{l:Tr Hash_ExpectedHash}" />
            <Border Classes="badge" CornerRadius="8" Padding="12,8" HorizontalAlignment="Stretch"
                    Classes.success="{Binding CompareMatched}" Classes.error="{Binding !CompareMatched}"
                    IsVisible="{Binding CompareResult, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Name="CompareText" Text="{Binding CompareResult}" FontSize="13" />
            </Border>
          </StackPanel>
        </controls:ToolPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
