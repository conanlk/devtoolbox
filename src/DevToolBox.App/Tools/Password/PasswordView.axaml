<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:DevToolBox.App.Localization"
             xmlns:vm="using:DevToolBox.App.Tools.Password"
             xmlns:controls="using:DevToolBox.App.Shared.Controls"
             xmlns:conv="using:DevToolBox.App.Shared.Converters"
             x:Class="DevToolBox.App.Tools.Password.PasswordView"
             x:DataType="vm:PasswordViewModel">
  <UserControl.Styles>
    <Style Selector="Border.meter">
      <Setter Property="Height" Value="6" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="{DynamicResource Brush.Badge}" />
    </Style>
    <Style Selector="Border.meter.on">
      <Setter Property="Background" Value="{DynamicResource Brush.Success}" />
    </Style>
    <Style Selector="StackPanel.weak Border.meter.on">
      <Setter Property="Background" Value="{DynamicResource Brush.Error}" />
    </Style>
    <Style Selector="StackPanel.fair Border.meter.on">
      <Setter Property="Background" Value="{DynamicResource Brush.Warning}" />
    </Style>
    <Style Selector="StackPanel.weak TextBlock.strength">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Error}" />
    </Style>
    <Style Selector="StackPanel.fair TextBlock.strength">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
    </Style>
    <Style Selector="TextBlock.strength">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Border.option">
      <Setter Property="Background" Value="{DynamicResource Brush.Well}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="MinHeight" Value="40" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="32,8,32,24" Spacing="16" MaxWidth="980" HorizontalAlignment="Left">
      <Border Classes="segmented" HorizontalAlignment="Left" AutomationProperties.Name="{l:Tr Password_Mode}">
        <StackPanel Orientation="Horizontal">
          <RadioButton Theme="{StaticResource SegmentButton}" GroupName="mode" Content="{l:Tr Password_ModePassword}" Name="PasswordModeButton" Height="32" Padding="14,0"
                       IsChecked="{Binding Mode, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter=Password}" />
          <RadioButton Theme="{StaticResource SegmentButton}" GroupName="mode" Content="{l:Tr Password_ModePassphrase}" Name="PassphraseModeButton" Height="32" Padding="14,0"
                       IsChecked="{Binding Mode, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter=Passphrase}" />
        </StackPanel>
      </Border>

      <!-- Generated value -->
      <Border Classes="panel" CornerRadius="12" Padding="24">
        <StackPanel Spacing="18">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <controls:SegmentedText Name="CurrentText" Classes="mono" FontSize="26" FontWeight="Medium" LetterSpacing="1" TextWrapping="Wrap"
                                    Segments="{Binding CurrentSegments}" VerticalAlignment="Center" AutomationProperties.Name="{l:Tr Password_GeneratedPassword}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Name="GenerateButton" Width="44" Height="44" Padding="0" CornerRadius="10" Command="{Binding GenerateCommand}"
                      ToolTip.Tip="{l:Tr Password_Regenerate}" AutomationProperties.Name="{l:Tr Password_Regenerate}">
                <controls:LucideIcon Kind="RefreshCw" Width="18" Height="18" HorizontalAlignment="Center" />
              </Button>
              <controls:CopyButton Name="CopyCurrentButton" Classes="primary" Height="44" Padding="18,0" CornerRadius="10" Text="{Binding Current}" />
            </StackPanel>
          </Grid>
          <StackPanel Spacing="8" Classes.weak="{Binding IsWeak}" Classes.fair="{Binding IsFair}">
            <ItemsControl Name="StrengthBar" ItemsSource="{Binding StrengthBars}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Rows="1" ColumnSpacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:Boolean">
                  <Border Classes="meter" Classes.on="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="strength" Name="StrengthLabelText" Text="{Binding StrengthLabel}" />
              <TextBlock Grid.Column="1" Classes="mono" FontSize="13" Name="StrengthText" Text="{Binding EntropyText}"
                         Foreground="{DynamicResource Brush.TextSecondary}" />
            </Grid>
          </StackPanel>
          <TextBlock Classes="error" Name="ErrorText" Text="{Binding ErrorMessage}"
                     IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="1.3*,16,*">
        <!-- Options -->
        <controls:ToolPanel Header="{l:Tr Password_Options}" Padding="16">
          <StackPanel Spacing="16">
            <StackPanel Spacing="14" IsVisible="{Binding IsPasswordMode}">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{l:Tr Password_Length}" FontSize="14" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Classes="chip" Background="{DynamicResource Brush.Well}" BorderBrush="{DynamicResource Brush.InputBorder}" BorderThickness="1">
                    <TextBlock Text="{Binding Length, StringFormat='{}{0:0}'}" FontSize="14" />
                  </Border>
                </Grid>
                <Slider Name="LengthSlider" Minimum="{Binding MinLength}" Maximum="128" Value="{Binding Length}" TickFrequency="1"
                        IsSnapToTickEnabled="True" AutomationProperties.Name="{l:Tr Password_Length}" />
              </StackPanel>
              <UniformGrid Columns="2" ColumnSpacing="12" RowSpacing="12">
                <Border Classes="option"><CheckBox Name="UppercaseBox" Content="{l:Tr Password_UppercaseOption}" IsChecked="{Binding Uppercase}" /></Border>
                <Border Classes="option"><CheckBox Name="LowercaseBox" Content="{l:Tr Password_LowercaseOption}" IsChecked="{Binding Lowercase}" /></Border>
                <Border Classes="option"><CheckBox Name="DigitsBox" Content="{l:Tr Password_DigitsOption}" IsChecked="{Binding Digits}" /></Border>
                <Border Classes="option"><CheckBox Name="SymbolsBox" Content="{l:Tr Password_SymbolsOption}" IsChecked="{Binding Symbols}" /></Border>
              </UniformGrid>
              <CheckBox Content="{l:Tr Password_ExcludeAmbiguous}" IsChecked="{Binding ExcludeAmbiguous}" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="field-label" Text="{l:Tr Password_Exclude}" />
                <TextBox Classes="mono" Text="{Binding ExcludeCharacters}" Width="200" PlaceholderText="{l:Tr Password_ExcludePlaceholder}"
                         AutomationProperties.Name="{l:Tr Password_ExcludeName}" />
              </StackPanel>
            </StackPanel>

            <StackPanel Spacing="14" IsVisible="{Binding IsPassphraseMode}">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{l:Tr Password_Words}" FontSize="14" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Classes="chip" Background="{DynamicResource Brush.Well}" BorderBrush="{DynamicResource Brush.InputBorder}" BorderThickness="1">
                    <TextBlock Text="{Binding WordCount, StringFormat='{}{0:0}'}" FontSize="14" />
                  </Border>
                </Grid>
                <Slider Name="WordsSlider" Minimum="3" Maximum="12" Value="{Binding WordCount}" TickFrequency="1" IsSnapToTickEnabled="True"
                        AutomationProperties.Name="{l:Tr Password_NumberOfWords}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="field-label" Text="{l:Tr Password_Separator}" />
                <ComboBox Name="SeparatorBox" ItemsSource="{Binding Separators}" SelectedItem="{Binding SelectedSeparator}" MinWidth="160"
                          AutomationProperties.Name="{l:Tr Password_Separator}" />
              </StackPanel>
              <UniformGrid Columns="2" ColumnSpacing="12">
                <Border Classes="option"><CheckBox Name="CapitalizeBox" Content="{l:Tr Password_Capitalize}" IsChecked="{Binding Capitalize}" /></Border>
                <Border Classes="option"><CheckBox Name="IncludeNumberBox" Content="{l:Tr Password_AddNumber}" IsChecked="{Binding IncludeNumber}" /></Border>
              </UniformGrid>
              <TextBlock Classes="hint" Text="{l:Tr Password_WordlistNote}" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Classes="field-label" Text="{l:Tr Common_Generate}" />
              <NumericUpDown Name="CountBox" Value="{Binding Count}" Minimum="1" Maximum="1000" Increment="1" FormatString="0" Width="120"
                             AutomationProperties.Name="{l:Tr Password_HowMany}" />
              <TextBlock Classes="field-label" Text="{l:Tr Password_AtOnce}" />
            </StackPanel>
          </StackPanel>
        </controls:ToolPanel>

        <!-- This session -->
        <controls:ToolPanel Grid.Column="2" Header="{l:Tr Password_ThisSession}" Padding="16" VerticalAlignment="Top">
          <controls:ToolPanel.Actions>
            <Button Classes="tool quiet" Content="{l:Tr Common_Clear}" Command="{Binding ClearHistoryCommand}" AutomationProperties.Name="{l:Tr Password_ClearHistory}" />
          </controls:ToolPanel.Actions>
          <StackPanel Spacing="8">
            <ItemsControl Name="HistoryList" ItemsSource="{Binding History}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HistoryEntry">
                  <Border Classes="option" Margin="0,0,0,6">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                      <TextBlock Classes="mono" Text="{Binding Masked}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource Brush.TextSubtle}" />
                      <TextBlock Grid.Column="1" Classes="hint" Text="{Binding Ago}" VerticalAlignment="Center" />
                      <controls:CopyButton Grid.Column="2" Classes="quiet" Text="{Binding Value}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="hint" Text="{l:Tr Password_NoHistory}" IsVisible="{Binding !HasHistory}" />
            <TextBlock Classes="hint" Text="{l:Tr Password_MemoryOnly}" TextWrapping="Wrap" />
          </StackPanel>
        </controls:ToolPanel>
      </Grid>

      <!-- Bulk results -->
      <controls:ToolPanel Header="{l:Tr Password_AllGenerated}" Padding="0" IsVisible="{Binding HasMany}">
        <controls:ToolPanel.Actions>
          <controls:CopyButton Classes="quiet" Text="{Binding AllPasswords}" />
        </controls:ToolPanel.Actions>
        <ListBox Name="PasswordList" ItemsSource="{Binding Passwords}" Background="Transparent" MaxHeight="320"
                 AutomationProperties.Name="{l:Tr Password_GeneratedPasswords}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <Grid ColumnDefinitions="*,Auto">
                <SelectableTextBlock Classes="mono" Text="{Binding}" VerticalAlignment="Center" FontSize="14" />
                <controls:CopyButton Grid.Column="1" Classes="quiet" Text="{Binding}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </controls:ToolPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
